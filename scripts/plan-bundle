#!/usr/bin/env python3
"""Create and resolve immutable, repository-scoped PIES plan bundles."""

from __future__ import annotations

import argparse
import json
import os
import re
import runpy
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any

PLAN_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
REQUIRED_FILES = ("dag.json", "plan.md", "plan-review.json")
DAG_NEXT = Path(__file__).with_name("dag-next")


def fail(message: str) -> None:
    raise SystemExit(f"pies-plan-bundle: {message}")


def repository_basename(repo: Path) -> str:
    result = subprocess.run(
        ["git", "-C", str(repo), "rev-parse", "--git-common-dir"], text=True, capture_output=True
    )
    if result.returncode:
        fail(f"not a Git repository: {repo}")
    common = Path(result.stdout.strip())
    if not common.is_absolute():
        common = (repo / common).resolve()
    return common.parent.name


def artifact_root() -> Path:
    return Path(os.environ.get("PIES_ARTIFACT_ROOT", Path.home() / ".pies")).expanduser().resolve()


def validate_plan_id(plan_id: str) -> str:
    if not PLAN_ID.fullmatch(plan_id):
        fail("plan ID must contain only letters, digits, '.', '_' or '-', without traversal")
    return plan_id


def plan_path(repo: Path, plan_id: str) -> Path:
    return artifact_root() / "runs" / repository_basename(repo) / "plans" / validate_plan_id(plan_id)


def read_json(path: Path, label: str) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"cannot read {label}: {exc}")
    if not isinstance(value, dict):
        fail(f"{label} must be a JSON object")
    return value


def validate_review(review: dict[str, Any]) -> None:
    provenance = review.get("provenance")
    if not isinstance(provenance, list) or not provenance or not all(isinstance(item, str) and item for item in provenance):
        fail("plan-review.json needs non-empty provenance")
    if not isinstance(review.get("creation_revision"), str) or not review["creation_revision"]:
        fail("plan-review.json needs creation_revision")
    for name in ("attacks", "warnings"):
        if not isinstance(review.get(name), list):
            fail(f"plan-review.json needs {name} array")
    for warning in review["warnings"]:
        if not isinstance(warning, dict) or not isinstance(warning.get("attack"), str) or not warning["attack"]:
            fail("each warning needs an attack")
        if not isinstance(warning.get("detail"), str) or not warning["detail"]:
            fail("each warning needs detail")


def validate_dag(path: Path) -> dict[str, Any]:
    namespace = runpy.run_path(str(DAG_NEXT))
    try:
        return namespace["load_dag"](path)
    except SystemExit as exc:
        fail(str(exc))


def validate_bundle(bundle: Path) -> dict[str, Any]:
    if not bundle.is_dir():
        fail(f"plan does not exist: {bundle}")
    missing = [name for name in REQUIRED_FILES if not (bundle / name).is_file()]
    if missing:
        fail(f"plan is incomplete; missing {', '.join(missing)}")
    if not (bundle / "plan.md").read_text(encoding="utf-8").strip():
        fail("plan.md must not be empty")
    dag = validate_dag(bundle / "dag.json")
    validate_review(read_json(bundle / "plan-review.json", "plan-review.json"))
    return dag


def atomic_write(path: Path, content: bytes) -> None:
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as handle:
        handle.write(content)
        temp = Path(handle.name)
    try:
        os.replace(temp, path)
    finally:
        temp.unlink(missing_ok=True)


def create_bundle(repo: Path, plan_id: str, dag_file: Path, plan_file: Path, review_file: Path) -> Path:
    target = plan_path(repo, plan_id)
    if target.exists():
        fail(f"plan already exists and is immutable: {target}")
    dag = validate_dag(dag_file)
    plan = plan_file.read_text(encoding="utf-8")
    if not plan.strip():
        fail("plan.md input must not be empty")
    review = read_json(review_file, "plan-review input")
    validate_review(review)
    target.parent.mkdir(parents=True, exist_ok=True)
    target.mkdir()
    atomic_write(target / "dag.json", json.dumps(dag, indent=2, ensure_ascii=False).encode() + b"\n")
    atomic_write(target / "plan.md", plan.encode())
    atomic_write(target / "plan-review.json", json.dumps(review, indent=2, ensure_ascii=False).encode() + b"\n")
    return target


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    create = commands.add_parser("create")
    create.add_argument("--repo", required=True, type=Path)
    create.add_argument("--plan-id", required=True)
    create.add_argument("--dag", required=True, type=Path)
    create.add_argument("--plan", required=True, type=Path)
    create.add_argument("--review", required=True, type=Path)
    resolve = commands.add_parser("resolve")
    resolve.add_argument("--repo", required=True, type=Path)
    resolve.add_argument("plan_id")
    args = parser.parse_args()
    if args.command == "create":
        print(create_bundle(args.repo.resolve(), args.plan_id, args.dag.resolve(), args.plan.resolve(), args.review.resolve()))
    else:
        bundle = plan_path(args.repo.resolve(), args.plan_id)
        validate_bundle(bundle)
        print(bundle)
    return 0


if __name__ == "__main__":
    sys.exit(main())
